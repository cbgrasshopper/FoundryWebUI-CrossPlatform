@page
@model FoundryWebUI.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<div class="d-flex flex-column h-100 p-3" style="overflow-y: auto;">
    <div class="page-header">
        <h3>Settings</h3>
    </div>

    <!-- Foundry CLI Info -->
    <div class="panel mb-3">
        <div class="panel-header">Foundry CLI</div>
        <div class="panel-body">
            <div id="foundry-info-loading" class="text-tertiary" style="font-size: 0.85rem;">Detecting...</div>
            <div id="foundry-info-content" style="display: none;">
                <div class="d-flex align-items-center gap-sm">
                    <span id="foundry-info-icon"></span>
                    <code class="text-mono" id="foundry-info-path" style="font-size: 0.8rem; color: var(--text-secondary); word-break: break-all;"></code>
                </div>
            </div>
        </div>
    </div>

    <!-- Model Cache Directory -->
    <div class="panel mb-3">
        <div class="panel-header">Model Cache Directory</div>
        <div class="panel-body">
            <p class="text-tertiary" style="font-size: 0.8rem; margin-bottom: 12px;">The directory where Foundry Local stores downloaded model files. Changing this requires the Foundry CLI and may require restarting the Foundry service.</p>
            <div id="cache-dir-loading" class="text-tertiary" style="font-size: 0.85rem;">Loading...</div>
            <div id="cache-dir-content" style="display: none;">
                <div class="d-flex gap-sm">
                    <input type="text" id="cache-dir-path" class="input-dark text-mono flex-grow-1" placeholder="e.g. /path/to/cache" />
                    <button id="btn-save-cache-dir" class="btn-action">Save</button>
                </div>
                <div id="cache-dir-status" class="mt-2" style="display: none;"></div>
            </div>
        </div>
    </div>

    <!-- System Prompts -->
    <div class="panel flex-grow-1 overflow-hidden d-flex flex-column">
        <div class="panel-header">
            <span>System Prompts</span>
            <button id="btn-add-prompt" class="btn-action" style="font-size: 0.75rem; padding: 3px 12px;">New Prompt</button>
        </div>
        <div class="flex-grow-1 overflow-auto">
            <div id="prompts-list" class="list-group list-group-flush">
                <div class="text-center py-4" style="color: var(--text-tertiary);">Loading...</div>
            </div>
        </div>
    </div>

    <!-- Prompt Editor Modal -->
    <div class="modal fade" id="prompt-modal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="prompt-modal-title">New System Prompt</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="prompt-name" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">Name</label>
                        <input type="text" id="prompt-name" class="input-dark" style="width: 100%;" placeholder="e.g. Code Assistant, Translator, Summarizer" />
                    </div>
                    <div class="mb-3">
                        <label for="prompt-content" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">System Prompt</label>
                        <textarea id="prompt-content" class="input-dark" rows="8" style="width: 100%;" placeholder="You are a helpful assistant that..."></textarea>
                        <div class="text-tertiary" style="font-size: 0.75rem; margin-top: 4px;">This message is sent as the system role at the start of every conversation using this prompt.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-save-prompt" class="btn-action">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/settings.js" asp-append-version="true"></script>
}
