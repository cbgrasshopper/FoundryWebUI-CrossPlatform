@page
@model IndexModel
@{
    ViewData["Title"] = "Chat";
}

<div class="d-flex flex-column h-100">
    <!-- Status Bar -->
    <div class="chat-status-bar">
        <span id="foundry-status-indicator" class="badge-status badge-muted">Checking...</span>
        <span id="foundry-endpoint-display" class="text-tertiary text-mono" style="font-size: 0.75rem;"></span>
        <button id="btn-reconnect-foundry" class="btn-ghost" style="font-size: 0.75rem;"><svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 3a5 5 0 11-4.546 2.914.5.5 0 00-.908-.418A6 6 0 108 2v1z"/><path d="M8 4.466V.534a.25.25 0 00-.41-.192L5.23 2.308a.25.25 0 000 .384l2.36 1.966A.25.25 0 008 4.466z"/></svg> Reconnect</button>
        <button id="btn-start-foundry" class="btn-success-ghost" style="font-size: 0.75rem; display: none;">Start Foundry</button>
    </div>

    <!-- Toolbar -->
    <div class="chat-toolbar">
        <label>Model</label>
        <div id="model-select" class="custom-select" style="min-width: 200px; max-width: 520px;">
            <div class="custom-select-trigger" tabindex="0">
                <span class="trigger-text">Loading models...</span>
                <svg class="trigger-arrow" width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M4.427 7.427l3.396 3.396a.25.25 0 00.354 0l3.396-3.396A.25.25 0 0011.396 7H4.604a.25.25 0 00-.177.427z"/></svg>
            </div>
            <div class="custom-select-options"></div>
        </div>
        <button id="btn-new-chat" class="btn-ghost" style="margin-left: 16px;">New Chat</button>
    </div>
    <div class="chat-toolbar" style="border-top: none; padding-top: 0;">
        <label for="prompt-select">System Prompt</label>
        <select id="prompt-select" class="input-dark" style="max-width: 220px;">
            <option value="">None</option>
        </select>

        <label for="max-tokens-slider">Max Tokens</label>
        <input type="range" id="max-tokens-slider" class="range-dark" min="256" max="4096" step="256" value="2048" style="width: 100px;" />
        <span id="max-tokens-value" class="text-mono text-tertiary" style="min-width: 40px; font-size: 0.8rem;">2048</span>

        <label class="toggle-switch" style="margin-left: 16px;">
            <input type="checkbox" id="show-thinking" />
            <span class="toggle-track"></span>
            Thinking
        </label>
    </div>

    <!-- Download Banner -->
    <div id="chat-download-banner" class="chat-dl-banner d-none">
        <div class="d-flex align-items-center gap-sm">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="var(--yellow)" style="flex-shrink:0;"><path d="M8.22 1.754a.25.25 0 00-.44 0L1.698 13.132a.25.25 0 00.22.368h12.164a.25.25 0 00.22-.368L8.22 1.754zm-1.763-.707c.659-1.234 2.427-1.234 3.086 0l6.082 11.378A1.75 1.75 0 0114.082 15H1.918a1.75 1.75 0 01-1.543-2.575L6.457 1.047zM9 11a1 1 0 11-2 0 1 1 0 012 0zm-.25-5.25a.75.75 0 00-1.5 0v2.5a.75.75 0 001.5 0v-2.5z"/></svg>
            <span id="chat-dl-text" style="flex: 1;"></span>
            <button id="chat-dl-retry" class="btn-success-ghost d-none" style="font-size: 0.78rem;">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M2.75 14A1.75 1.75 0 011 12.25v-2.5a.75.75 0 011.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 00.25-.25v-2.5a.75.75 0 011.5 0v2.5A1.75 1.75 0 0113.25 14H2.75zM8 10a.75.75 0 01-.75-.75V1.75a.75.75 0 011.5 0v7.5A.75.75 0 018 10zm-3.22-2.72a.75.75 0 011.06 0L8 9.44l2.16-2.16a.75.75 0 111.06 1.06l-2.69 2.69a.75.75 0 01-1.06 0L4.78 8.34a.75.75 0 010-1.06z"/></svg>
                Download
            </button>
            <button id="chat-dl-dismiss" class="btn-danger-ghost d-none" style="font-size: 0.78rem;">Dismiss</button>
        </div>
        <div class="progress-track" style="margin-top: 6px;">
            <div id="chat-dl-bar" class="progress-fill" style="width: 0%;"></div>
        </div>
    </div>

    <!-- Messages -->
    <div id="chat-messages" class="flex-grow-1 overflow-auto p-3">
        <div class="chat-welcome">
            <h4>FoundryWebUI-X</h4>
            <p>Select a model and start chatting</p>
        </div>
    </div>

    <!-- Input Area -->
    <div class="chat-input-area">
        <textarea id="chat-input" class="input-dark flex-grow-1" rows="4" placeholder="Type your message... (Shift+Enter for new line)"></textarea>
        <button id="btn-send" class="btn-action" disabled>
            <span id="send-text">Send</span>
            <span id="send-spinner" class="spinner-border spinner-border-sm d-none" style="width: 14px; height: 14px;"></span>
        </button>
        <button id="btn-stop" class="btn-danger-ghost d-none">Stop</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
