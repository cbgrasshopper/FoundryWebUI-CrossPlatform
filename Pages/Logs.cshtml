@page
@model FoundryWebUI.Pages.LogsModel
@{
    ViewData["Title"] = "Logs";
}

<div class="d-flex flex-column h-100 p-3">
    <div class="page-header">
        <h3>Logs</h3>
        <div class="d-flex gap-sm">
            <button id="btn-refresh-logs" class="btn-ghost">Refresh</button>
            <button id="btn-auto-scroll" class="btn-ghost active" title="Auto-scroll to bottom" style="border-color: var(--accent); color: var(--accent);">Auto-scroll</button>
        </div>
    </div>

    <div class="d-flex align-items-center gap-sm mb-2">
        <strong>Foundry Local Logs</strong>
        <span id="foundry-count" class="tab-badge">0</span>
    </div>

    <!-- Source Tabs -->
    <div class="tab-nav d-flex gap-sm mb-2">
        <button class="tab-btn" data-source="foundry">Foundry</button>
    </div>

    <!-- Filters -->
    <div class="d-flex gap-sm mb-2 align-items-center">
        <select id="log-level-filter" class="input-dark" style="width: auto;">
            <option value="all">All Levels</option>
            <option value="error">Errors Only</option>
            <option value="warn">Warnings+</option>
            <option value="info" selected>Info+</option>
            <option value="debug">Debug (All)</option>
        </select>
        <input type="text" id="log-search" class="input-dark" style="max-width: 280px;" placeholder="Search logs..." />
        <span id="log-showing" class="text-tertiary text-mono ms-auto" style="font-size: 0.75rem;"></span>
    </div>

    <!-- Log Content -->
    <div id="log-viewer" class="log-viewer flex-grow-1">
        <div style="color: var(--text-tertiary); padding: 16px; text-align: center;">Loading logs...</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/logs.js" asp-append-version="true"></script>
}
